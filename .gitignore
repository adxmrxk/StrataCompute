# Build trees — regenerated by CMake; contain the downloaded ONNX Runtime,
# fetched Google Benchmark sources, and all compiled objects. Never commit.
/build/
/build-onnx/
/build-bench/
/build-*/

# Generated benchmark output (regenerable; latency varies run-to-run).
/results/

# Downloaded public data and trained demo artifacts are reproducible with
# scripts/get_uci_har.py and scripts/train_har_demo.py; do not commit them.
/data/uci_har/
/data/demo/
/models/har_activity.onnx
/models/har_activity_io.csv

# Third-party fetch/extract caches.
**/_ort/
**/_deps/

# Python
__pycache__/
*.pyc
/.venv/
/venv/

# Agent / IDE / OS noise
/.claude/
.vs/
.vscode/
*.user
Thumbs.db
.DS_Store

# Stray build artifacts (build dirs above already cover the normal case)
*.obj
*.o
*.lib
*.dll
*.exe
*.pdb

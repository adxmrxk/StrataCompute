# Normalise line endings in the repo so a Windows checkout can't corrupt the
# Linux build. The Docker entrypoint MUST stay LF or the container fails with
# a cryptic "no such file or directory" on the shebang.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.bat  text eol=crlf

# Binary model asset — never EOL-munge.
*.onnx binary
